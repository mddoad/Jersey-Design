# ── SSLCommerz (required for payments) ──
# Get sandbox credentials at: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=your_store_id_here
SSLCOMMERZ_STORE_PASSWORD=your_store_password_here

# Set to 'false' for live/production mode (default: sandbox/true)
SSLCOMMERZ_SANDBOX=true

# Price per jersey in paisa (default: ৳1,500.00 = 150000 paisa)
UNIT_PRICE_CENTS=150000

# Currency code (default: bdt)
CURRENCY=bdt

# Backend server port (default: 4242)
PORT=4242

# Backend URL (SSLCommerz needs to reach this for IPN callbacks)
SERVER_URL=http://localhost:4242

# Frontend URL (for redirects after payment)
CLIENT_URL=http://localhost:5173

# ── Frontend (set in .env or prefixed with VITE_) ──
# Only needed in production when API is on a different host:
# VITE_API_URL=https://your-api.example.com

# ── Supabase (optional — for design sharing) ──
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJxxxxx
